# .env NAMUNASI — nusxa oling: `cp .env.example .env`, so'ng qiymatlarni to'ldiring.
# Haqiqiy .env git'ga kirmaydi (.gitignore). Bu faylga HAQIQIY parol yozmang.

# Server (majburiy)
COMPANY_URL=https://app3.greenwhite.uz/xtrade

# Mavjud company rejimi
CREATE_COMPANY=0
# 0 = test-results/data/data_store.json dagi oxirgi saqlangan company_code
COMPANY_CODE=your_company_code
COMPANY_PASSWORD=your_company_password

# Admin authorization: admin@COMPANY_CODE + COMPANY_PASSWORD.
# User paroli berilmasa loyiha default qiymati ishlatiladi.
USER_PASSWORD=your_user_password

# New company/head admin rejimi. CREATE_COMPANY=1 bo'lsa ikkalasi ham majburiy.
#CREATE_COMPANY=1
#HEAD_ADMIN_EMAIL=admin@head
#HEAD_ADMIN_PASSWORD=your_head_password

# Ixtiyoriy run flaglari
HEADLESS=0
# 1 = yangi 6 xonali code; 0 = test-results/data/data_store.json dagi mavjud code
NEW_CODE=0
# Faqat CREATE_COMPANY=1 bilan ishlaydi.
DISABLE_LICENSE_POLICY=0
# Test tugagach eng oxirgi Playwright trace viewerini ochadi.
SHOW_TRACE=0
# Faqat FAILED natijada Gemini AI tahlilini Telegram va Allure'ga qo'shadi.
# 1 = yoqilgan; 0 = o'chirilgan.
AI_ANALYSIS=0
# AI_ANALYSIS=1 bo'lsa majburiy. Haqiqiy keyni faqat lokal .env yoki secret store'ga yozing.
GEMINI_API_KEY=your_gemini_api_key
# Ixtiyoriy; berilmasa koddagi default model ishlatiladi.
#GEMINI_MODEL=gemini-2.5-flash
