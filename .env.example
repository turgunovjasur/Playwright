# .env NAMUNASI — nusxa oling: `cp .env.example .env`, so'ng qiymatlarni to'ldiring.
# Haqiqiy .env git'ga kirmaydi (.gitignore). Bu faylga HAQIQIY parol yozmang.

# Server (majburiy; oxirida / va bo'sh joy bo'lmasin)
COMPANY_URL=https://app3.greenwhite.uz/xtrade

# 1 = yangi kompaniya yaratish; boshqa kod = mavjud kompaniyada ishlash.
COMPANY_CODE=your_company_code
COMPANY_PASSWORD=your_company_password

# Admin authorization: admin@COMPANY_CODE + COMPANY_PASSWORD.
# User yaratish, parolini tasdiqlash va web/mobile login uchun yagona parol.
# Barcha runlarda check_requiremants tomonidan boshlanishida tekshiriladi.
USER_PASSWORD=your_user_password

# Yangi kompaniya: yuqoridagi COMPANY_CODE qiymatini 1 qiling.
# COMPANY_CODE=1 bo'lsa quyidagi ikkala qiymat ham majburiy.
#HEAD_ADMIN_EMAIL=admin@head
#HEAD_ADMIN_PASSWORD=your_head_password

# Ixtiyoriy run flaglari: faqat 1 yoki 0; berilmasa o'chirilgan.
HEADLESS=0
# 1 = yangi 6 xonali code; 0 = test-results/data/data_store.json dagi mavjud code
NEW_CODE=0
# Faqat COMPANY_CODE=1 bilan ishlaydi.
DISABLE_LICENSE_POLICY=0
# Test tugagach eng oxirgi Playwright trace viewerini ochadi.
SHOW_TRACE=0
# 1 — FAILED natijada AI yoqiladi; 0 — faqat system summary (default).
AI_ANALYSIS=0
# Har analyzer/suite runida ko'pi bilan shuncha failed test AI'ga yuboriladi.
# Musbat butun son; qayta urinish bilan har testga ko'pi bilan 2 so'rov.
AI_MAX_CASES=5
# Haqiqiy keyni faqat lokal .env yoki secret store'ga yozing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Telegram CI bot (faqat bot ishlatilsa token/parol to'ldiriladi).
# Maxfiy bo'lmagan sozlamalar: telegram_bot/telegram_ci_config.json
TELEGRAM_BOT_TOKEN=
TELEGRAM_RUN_PASSWORD=
GITHUB_TOKEN=
HOURLY_SCHEDULE_ENABLED=0
